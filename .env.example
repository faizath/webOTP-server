NODE_ENV=development
CORS_ORIGINS=*
SWAGGER_ENABLED=false
PORT=3000

# Leave DB_HOST empty to run without a database. Health will report database: down.
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_NAME=webotp

# Required by the MSSQL container.
MSSQL_SA_PASSWORD=YourStrong!Passw0rd

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12
