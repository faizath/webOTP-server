{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "imports": {
    "@nestjs/common": "npm:@nestjs/common@^11.1.6",
    "@nestjs/config": "npm:@nestjs/config@^4.0.2",
    "@nestjs/core": "npm:@nestjs/core@^11.1.6",
    "@nestjs/jwt": "npm:@nestjs/jwt@^11.0.0",
    "@nestjs/platform-express": "npm:@nestjs/platform-express@^11.1.6",
    "@nestjs/passport": "npm:@nestjs/passport@^11.0.5",
    "@nestjs/throttler": "npm:@nestjs/throttler@^6.4.0",
    "bcryptjs": "npm:bcryptjs@^3.0.2",
    "class-transformer": "npm:class-transformer@^0.5.1",
    "class-validator": "npm:class-validator@^0.14.2",
    "dotenv": "npm:dotenv@^16.6.1",
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "mssql": "npm:mssql@^11.0.1",
    "passport": "npm:passport@^0.7.0",
    "passport-jwt": "npm:passport-jwt@^4.0.1",
    "reflect-metadata": "npm:reflect-metadata@^0.2.2",
    "rxjs": "npm:rxjs@^7.8.2",
    "typeorm": "npm:typeorm@^0.3.27",
    "zod": "npm:zod@^4.1.5"
  },
  "tasks": {
    "dev": "deno run --watch --allow-env --allow-net --allow-read src/main.ts",
    "start": "deno run --allow-env --allow-net --allow-read src/main.ts",
    "test": "deno test --allow-env --allow-net --allow-read",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "migration:run": "deno run -A npm:typeorm migration:run -- -d src/database/data-source.ts",
    "migration:generate": "deno run -A npm:typeorm migration:generate -- -d src/database/data-source.ts"
  }
}
